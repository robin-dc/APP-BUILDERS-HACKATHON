# EAS uses this file instead of .gitignore. It matches .gitignore except that models/ is
# uploaded, because the app bundles those GGUFs. Keep the two files in sync otherwise.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# stray model files outside models/ (not bundled)
/*.gguf

# generated native folders
/ios
/android
